# Copy to .env and fill what you have. All optional; tier 0 runs with none.
# REHEARSAL_MODEL=claude-haiku-4-5-20251001
# ANTHROPIC_API_KEY=        # tier 1 LLM: direct streaming API, ~1s voice-to-voice (not wired yet)
# OPENROUTER_API_KEY=       # alternative tier 1 LLM route (not wired yet)
# ELEVENLABS_API_KEY=       # tier 1 voice: wired, sentence-streamed Flash v2.5
# ELEVENLABS_VOICE_ID=      # optional, defaults to Rachel
# DEEPGRAM_API_KEY=         # tier 1 STT with tunable endpointing (not wired yet)
